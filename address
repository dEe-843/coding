# ✅ COMMON FUNCTION (CORE LOGIC)

```c id="core1"
void AddressBook_SelectHandler(uint8_t index, uint8_t state)
{
    uint8_t i, j;

    /* CHECKED */
    if(state == 1)
    {
        /* already selected? ignore */
        for(i = 0; i < selected_count; i++)
        {
            if(selected_index[i] == index)
                return;
        }

        /* max limit check */
        if(selected_count >= MAX_SELECT)
        {
            /* UI feedback: max 5 allowed */

            /* force uncheck UI checkbox if API supports */
            checkbox_state[index] = 0;
            return;
        }

        selected_index[selected_count++] = index;
        checkbox_state[index] = 1;
    }

    /* UNCHECKED */
    else
    {
        for(i = 0; i < selected_count; i++)
        {
            if(selected_index[i] == index)
            {
                for(j = i; j < selected_count - 1; j++)
                {
                    selected_index[j] = selected_index[j + 1];
                }

                selected_count--;
                break;
            }
        }

        checkbox_state[index] = 0;
    }
}
```

